# Backend
DATABASE_URL=postgresql+asyncpg://support:support@postgres:5432/support
DATABASE_URL_SYNC=postgresql+psycopg2://support:support@postgres:5432/support
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Comma-separated browser origins allowed by the API (include your ngrok frontend URL for demos).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_ENV=development
LOG_LEVEL=INFO
SEED_AGENT_EMAIL=agent@example.com
SEED_AGENT_PASSWORD=agent123!

# Embeddable chat widget (public URL used in embed snippets — set to ngrok frontend URL for demos)
FRONTEND_PUBLIC_URL=http://localhost:5173
VISITOR_TOKEN_EXPIRE_MINUTES=1440
WIDGET_RESUME_DAYS=7

# Day 2 — knowledge / AI
# Leave GEMINI_API_KEY empty for offline lexical embeddings + heuristic classifier.
# Set it to enable Gemini embeddings (`gemini-embedding-001`) and classification.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
KNOWLEDGE_TOP_K=5
AI_RETRIEVAL_TOP_K=10
AI_FINAL_TOP_K=5
AI_CONTEXT_MESSAGE_LIMIT=20
AI_MIN_RETRIEVAL_SCORE=0.35
SUPPORT_AGENT_GRAPH_VERSION=support-agent-v1

# Hybrid search (default = hybrid_rrf; set legacy for emergency rollback)
# AI_RETRIEVAL_MODE: hybrid_rrf | legacy
AI_RETRIEVAL_MODE=hybrid_rrf
AI_RRF_CANDIDATE_K=40
AI_RRF_K=60
AI_VECTOR_CANDIDATE_K=40
AI_FTS_CANDIDATE_K=40
HNSW_EF_SEARCH=40
# HNSW_M / HNSW_EF_CONSTRUCTION document migration index params (not runtime-required)
HNSW_M=16
HNSW_EF_CONSTRUCTION=64

# Day 5 — email + attachments
EMAIL_PROVIDER=mock
EMAIL_FROM_ADDRESS=support@acme.example
RESEND_API_KEY=
STORAGE_ROOT_DIR=/tmp/support-attachments
# Docker Compose mounts named volume attachment_uploads here so files survive restarts
EMAIL_WEBHOOK_SECRET=mock-secret

# Frontend (Vite — use VITE_ prefix)
# These are baked into the frontend image at build time (see docker-compose.yml).
# Local defaults:
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws

# -----------------------------------------------------------------------------
# ngrok demo (optional)
# -----------------------------------------------------------------------------
# Goal: share the UI + API over the internet without exposing Postgres, Redis,
# Celery worker, or Beat. Compose already publishes only:
#   - frontend → host :5173
#   - backend  → host :8000
#
# 1. Start the stack locally:
#      cp .env.example .env   # then edit as below
#      docker compose up --build
#
# 2. Open two tunnels (ngrok free/paid both work):
#      ngrok http 5173        # → https://<frontend>.ngrok-free.app
#      ngrok http 8000        # → https://<backend>.ngrok-free.app
#    Or use an ngrok agent config with two endpoints.
#
# 3. Point the frontend at the *backend* ngrok URL (rebuild required):
#      VITE_API_BASE_URL=https://<backend>.ngrok-free.app/api/v1
#      VITE_WS_BASE_URL=wss://<backend>.ngrok-free.app/ws
#
# 4. Allow the *frontend* ngrok origin on the API + widget public URL:
#      CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://<frontend>.ngrok-free.app
#      FRONTEND_PUBLIC_URL=https://<frontend>.ngrok-free.app
#
# 5. Rebuild so Vite picks up the new API/WS URLs, then restart backend for CORS:
#      docker compose up --build -d
#
# 6. Open https://<frontend>.ngrok-free.app (use the ngrok interstitial “Visit”
#    button on free tier if shown). Agent login stays the same (see README).
#
# Notes:
# - Use https / wss for ngrok URLs (not http / ws).
# - Changing VITE_* without --build will leave the old API host in the image.
# - Leave GEMINI_API_KEY empty for a fully offline demo, or set it for live AI.
