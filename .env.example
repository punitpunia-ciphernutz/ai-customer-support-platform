# Backend
DATABASE_URL=postgresql+asyncpg://support:support@postgres:5432/support
DATABASE_URL_SYNC=postgresql+psycopg2://support:support@postgres:5432/support
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_ENV=development
LOG_LEVEL=INFO
SEED_AGENT_EMAIL=agent@example.com
SEED_AGENT_PASSWORD=agent123!

# Day 2 — knowledge / AI
# Leave GEMINI_API_KEY empty for local heuristic classifier + hash embeddings.
# Set it later to enable real Gemini structured classification.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=hash-local
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
KNOWLEDGE_TOP_K=5

# Frontend (Vite — use VITE_ prefix)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
