# Production environment template.
# Copy to .env on the deploy host (or load via your secrets manager).
# Replace every REPLACE_* placeholder before starting the stack.

# Backend
DATABASE_URL=postgresql+asyncpg://REPLACE_DB_USER:REPLACE_DB_PASSWORD@postgres:5432/REPLACE_DB_NAME
DATABASE_URL_SYNC=postgresql+psycopg2://REPLACE_DB_USER:REPLACE_DB_PASSWORD@postgres:5432/REPLACE_DB_NAME
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=https://app.example.com
APP_ENV=production
LOG_LEVEL=INFO
SEED_AGENT_EMAIL=admin@example.com
SEED_AGENT_PASSWORD=REPLACE_STRONG_PASSWORD

FRONTEND_PUBLIC_URL=https://app.example.com
VISITOR_TOKEN_EXPIRE_MINUTES=1440
WIDGET_RESUME_DAYS=7

GEMINI_API_KEY=REPLACE_GEMINI_API_KEY
LLM_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
KNOWLEDGE_TOP_K=5
AI_RETRIEVAL_TOP_K=10
AI_FINAL_TOP_K=5
AI_CONTEXT_MESSAGE_LIMIT=20
AI_MIN_RETRIEVAL_SCORE=0.35
SUPPORT_AGENT_GRAPH_VERSION=support-agent-v1

AI_RETRIEVAL_MODE=hybrid_rrf
AI_RRF_CANDIDATE_K=40
AI_RRF_K=60
AI_VECTOR_CANDIDATE_K=40
AI_FTS_CANDIDATE_K=40
HNSW_EF_SEARCH=40
HNSW_M=16
HNSW_EF_CONSTRUCTION=64

EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=support@example.com
RESEND_API_KEY=REPLACE_RESEND_API_KEY
STORAGE_ROOT_DIR=/tmp/support-attachments
EMAIL_WEBHOOK_SECRET=REPLACE_EMAIL_WEBHOOK_SECRET

# Frontend build args (https / wss). Rebuild frontend after changing.
VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_WS_BASE_URL=wss://api.example.com/ws
