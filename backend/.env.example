# Copy from repo root .env.example or set in Compose
DATABASE_URL=postgresql+asyncpg://support:support@postgres:5432/support
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_ENV=development
LOG_LEVEL=INFO
SEED_AGENT_EMAIL=agent@example.com
SEED_AGENT_PASSWORD=agent123!

# Day 2 — knowledge / AI (Gemini only; leave key empty until configured)
GEMINI_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
KNOWLEDGE_TOP_K=5

# Hybrid search (default = hybrid_rrf; see repo root .env.example for full list)
AI_RETRIEVAL_MODE=hybrid_rrf
AI_RRF_CANDIDATE_K=40
AI_RRF_K=60
AI_VECTOR_CANDIDATE_K=40
AI_FTS_CANDIDATE_K=40
HNSW_EF_SEARCH=40
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
