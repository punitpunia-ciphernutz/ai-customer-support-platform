# Baked in at Vite build time. For Docker, set these in the repo-root .env
# (docker-compose passes them as build args). Rebuild after changes.
#
# Local:
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
#
# ngrok demo (replace with your backend tunnel; use wss for WebSockets):
# VITE_API_BASE_URL=https://<backend>.ngrok-free.app/api/v1
# VITE_WS_BASE_URL=wss://<backend>.ngrok-free.app/ws
